# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DB_URL="mongodb+srv://<username>:<password>@<cluster-url>/tour-management-backend?retryWrites=true&w=majority"

# JWT Authentication
JWT_ACCESS_SECRET=your_access_secret
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_SECRET=your_refresh_secret
JWT_REFRESH_EXPIRES=30d
BCRYPT_SALT_ROUND=10

# Super Admin Credentials
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=your_super_admin_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL="https://your-domain.com/api/v1/auth/google/callback"

# Session
EXPRESS_SESSION=your_express_session_secret

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# SSLCommerz Payment Gateway
SSL_STORE_ID=your_ssl_store_id
SSL_STORE_PASS=your_ssl_store_password
SSL_PAYMENT_API="https://sandbox.sslcommerz.com/gwprocess/v3/api.php"
SSL_VALIDATION_API="https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php"
SSL_IPN_URL="https://your-domain.com/api/v1/payment/validate-payment"
SSL_SUCCESS_BACKEND_URL="https://your-domain.com/api/v1/payment/success"
SSL_FAIL_BACKEND_URL="https://your-domain.com/api/v1/payment/fail"
SSL_CANCEL_BACKEND_URL="https://your-domain.com/api/v1/payment/cancel"
SSL_SUCCESS_FRONTEND_URL="http://localhost:5173/payment/success"
SSL_FAIL_FRONTEND_URL="http://localhost:5173/payment/fail"
SSL_CANCEL_FRONTEND_URL="http://localhost:5173/payment/cancel"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
SMTP_FROM=your_email@example.com

# Redis Configuration
REDIS_HOST=your_redis_host
REDIS_PORT=your_redis_port
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
